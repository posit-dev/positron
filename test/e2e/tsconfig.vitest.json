{
	// Type-checks the Vitest files under test/e2e with the e2e compiler options.
	// Run by `npm run test:positron:check-ts`.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"types": [
			"node",
			"vitest/globals"
		]
	},
	"include": [
		"**/*.vitest.ts",
		"**/*.vitest.tsx"
	],
	"exclude": [
		"node_modules"
	]
}
