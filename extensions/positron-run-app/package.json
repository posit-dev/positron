{
  "name": "positron-run-app",
  "displayName": "%displayName%",
  "description": "%description%",
  "version": "0.0.1",
  "publisher": "positron",
  "private": true,
  "engines": {
    "vscode": "^1.65.0"
  },
  "categories": [],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "positronRunApp.listApps",
        "title": "%command.listApps.title%",
        "category": "%command.category%",
        "agent": {
          "description": "Lists the apps Positron has run in this window with its run commands or Run App button: Dash, FastAPI, Flask, Gradio, marimo, Streamlit, and Shiny for R. Gives each app's file, status, and URL, including apps that have since exited. Does not include Shiny for Python apps, apps started under the debugger, or apps started before the window last reloaded.",
          "args": [],
          "returns": "An array with one object per app: `file` (the app file's URI), `name` (its framework), `status` (`starting`, `running`, `exited`, or `unknown`), `runsIn` (`terminal` or `console`), `preview` (where Positron previews it), and, once known, `url` (the address for the user, proxied on Posit Workbench), `localUrl` (the address for requests from inside the session, such as `curl`), `exitCode` (terminal apps), and `sessionId` (console apps).",
          "readOnly": true
        }
      },
      {
        "command": "positronRunApp.stopApp",
        "title": "%command.stopApp.title%",
        "category": "%command.category%",
        "agent": {
          "description": "Stops an app that Positron is running, one that positronRunApp.listApps reports. Sends Ctrl+C to the app's terminal or interrupts its console session, and closes its terminal if it is still running 5 seconds later. Closes the app's preview in the Viewer once it has stopped.",
          "args": [
            {
              "name": "file",
              "description": "The app file's URI, as positronRunApp.listApps reports it.",
              "required": true,
              "schema": {
                "type": "string"
              }
            }
          ],
          "returns": "`{ stopped: true, file, name, method }`, where `method` is `interrupted` or `terminated` (its terminal was closed); or `{ stopped: false, reason, message }`, where `reason` is `not-found` (Positron has no record of an app from that file), `not-running` (it has already exited), or `did-not-stop`."
        }
      }
    ],
    "menus": {
      "commandPalette": [
        {
          "command": "positronRunApp.listApps",
          "when": "false"
        },
        {
          "command": "positronRunApp.stopApp",
          "when": "false"
        }
      ]
    },
    "configuration": {
      "title": "App Launcher",
      "properties": {
        "positron.appLauncher.showEnableShellIntegrationMessage": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.appLauncher.showEnableShellIntegrationMessage%"
        },
        "positron.appLauncher.showShellIntegrationNotSupportedMessage": {
          "type": "boolean",
          "default": true,
          "description": "%configuration.appLauncher.showShellIntegrationNotSupportedMessage%"
        },
        "positron.runApp.previewMode": {
          "type": "string",
          "default": "viewer",
          "enum": [
            "viewer",
            "editor",
            "external",
            "none"
          ],
          "enumDescriptions": [
            "%configuration.runApp.previewMode.viewer%",
            "%configuration.runApp.previewMode.editor%",
            "%configuration.runApp.previewMode.external%",
            "%configuration.runApp.previewMode.none%"
          ],
          "description": "%configuration.runApp.previewMode%"
        },
        "positron.runApp.urlDetectionTimeout": {
          "type": "integer",
          "default": 25,
          "minimum": 1,
          "description": "%configuration.runApp.urlDetectionTimeout%"
        },
        "positron.appLauncher.terminalAppUrlOpenLocation": {
          "type": "string",
          "default": "ask",
          "enum": [
            "ask",
            "viewer",
            "browser"
          ],
          "enumDescriptions": [
            "%configuration.appLauncher.terminalAppUrlOpenLocation.ask%",
            "%configuration.appLauncher.terminalAppUrlOpenLocation.viewer%",
            "%configuration.appLauncher.terminalAppUrlOpenLocation.browser%"
          ],
          "description": "%configuration.appLauncher.terminalAppUrlOpenLocation%"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "dependencies": {},
  "devDependencies": {
    "@types/mocha": "^9.1.0",
    "@types/node": "^22.5.4",
    "@types/sinon": "^17.0.3",
    "@types/sinon-test": "^2.4.6",
    "typescript": "^4.5.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/posit-dev/positron"
  }
}
