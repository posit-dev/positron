# The analyzer's Rust sources and the script that builds them are development inputs. What ships
# is the compiled module at resources/sql-analyzer.wasm, which is committed; see
# scripts/build-analyzer.mts.
sql-analyzer/**
scripts/**

# esbuild bundles src/ into dist/extension.js. The TypeScript sources, the tests, and the
# build configuration do not ship.
src/**
out/**
tsconfig*.json
**/*.tsbuildinfo
esbuild*.mts
