{
	"name": "scratch",
	"displayName": "scratch",
	"description": "Scratch pad for trying things out in dev.",
	"version": "0.0.1",
	"publisher": "positron",
	"license": "Elastic-2.0",
	"private": true,
	"engines": {
		"vscode": "^1.130.0"
	},
	"categories": [
		"Other"
	],
	"activationEvents": [],
	"main": "./out/extension.js",
	"contributes": {
		"commands": [
			{
				"command": "scratch.helloWorld",
				"title": "Hello World"
			},
			{
				"command": "scratch.runLegacyProviderAction",
				"title": "Scratch: Run Legacy Provider Action"
			},
			{
				"command": "scratch.openProviderDemo",
				"title": "Scratch: Open Provider Demo (Webview Modal)"
			},
			{
				"command": "scratch.openProviderDemoDialog",
				"title": "Scratch: Open Provider Demo (Core Modal Dialog)"
			}
		]
	},
	"scripts": {
		"vscode:prepublish": "npm run compile",
		"compile": "tsc -p ./",
		"watch": "tsc -watch -p ./",
		"lint": "eslint src"
	}
}
