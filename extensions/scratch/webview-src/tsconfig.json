{
	"compilerOptions": {
		"module": "ESNext",
		"moduleResolution": "bundler",
		"target": "ES2022",
		"jsx": "react-jsx",
		"lib": [
			"ES2022",
			"DOM",
			"DOM.Iterable"
		],
		"noEmit": true,
		"strict": true,
		"noUnusedLocals": true,
		"noUnusedParameters": true,
		"noImplicitOverride": true,
		"forceConsistentCasingInFileNames": true,
		"skipLibCheck": true,
		"types": []
	},
	"include": [
		"./**/*",
		"../src/providerDemoProtocol.ts"
	]
}
