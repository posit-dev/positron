{
	"compilerOptions": {
		"module": "nodenext",
		"target": "ES2020",
		"moduleResolution": "nodenext",
		"outDir": "out",
		"rootDir": "src",
		"lib": [
			"ES2020"
		],
		"declaration": true,
		"sourceMap": true,
		"strict": false,
		"skipLibCheck": true,
		"types": [
			"node",
			"mocha"
		],
		"typeRoots": [
			"./node_modules/@types"
		]
	},
	"include": [
		"src/**/*"
	]
}
