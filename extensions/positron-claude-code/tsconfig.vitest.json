{
	// Type-checks this extension's Vitest files with its own compiler options.
	// Run by `npm run test:positron:check-ts`.
	"extends": "./tsconfig.json",
	"compilerOptions": {
		"noEmit": true,
		"types": [
			"node"
		]
	},
	"include": [
		"**/*.vitest.ts",
		"**/*.vitest.tsx",
		// Ambient declarations the build gets through its src/**/* include.
		"src/**/*.d.ts",
		"../../node_modules/vitest/globals.d.ts",
		"../../src/vscode-dts/vscode.d.ts",
		"../../src/positron-dts/positron.d.ts",
		"../../src/vscode-dts/vscode.proposed.positronErrorActions.d.ts"
	],
	"exclude": [
		"node_modules",
		"out"
	]
}
